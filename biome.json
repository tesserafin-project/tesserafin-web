                            "confirm": "Ambiguous global (confusing-browser-globals) - likely meant a local variable, not the window property.",
                            "screen": "Ambiguous global (confusing-browser-globals) - likely meant a local variable, not the window property.",
                            "screenLeft": "Ambiguous global (confusing-browser-globals) - likely meant a local variable, not the window property.",
                            "event": "Ambiguous global (confusing-browser-globals) - likely meant a local variable, not the window property.",
                            "onunload": "Ambiguous global (confusing-browser-globals) - likely meant a local variable, not the window property.",
                            "pageXOffset": "Ambiguous global (confusing-browser-globals) - likely meant a local variable, not the window property.",
                            "resizeBy": "Ambiguous global (confusing-browser-globals) - likely meant a local variable, not the window property.",
                            "statusbar": "Ambiguous global (confusing-browser-globals) - likely meant a local variable, not the window property.",
                            "close": "Ambiguous global (confusing-browser-globals) - likely meant a local variable, not the window property.",
                            "open": "Ambiguous global (confusing-browser-globals) - likely meant a local variable, not the window property.",
                            "print": "Ambiguous global (confusing-browser-globals) - likely meant a local variable, not the window property."
