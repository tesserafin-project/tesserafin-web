{
    "$schema": "https://biomejs.dev/schemas/2.5.4/schema.json",
    "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
    "files": {
        "includes": [
            "**",
            "!node_modules",
            "!coverage",
            "!dist",
            "!.idea",
            "!.vscode",
            "!src/lib/tesserafin-sdk/generated",
            "!tests/e2e/vendor"
        ]
    },
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 4
    },
    "linter": {
