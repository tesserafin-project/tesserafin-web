        "epubjs": {
            "@xmldom/xmldom": "0.8.13"
        },
        "vite": "6.4.3"
    },
    "browserslist": [
        "last 2 Chrome versions",
        "last 2 Firefox versions",
        "last 2 Safari versions",
        "last 2 Edge versions",
        "last 2 ChromeAndroid versions",
        "last 2 iOS versions",
        "Firefox ESR",
        "not dead"
    ],
    "scripts": {
        "start": "npm run serve",
        "serve": "webpack serve --config webpack.dev.js",
        "build:analyze": "cross-env NODE_ENV=\"production\" webpack --config webpack.analyze.js",
        "build:development": "webpack --config webpack.dev.js",
        "build:production": "cross-env NODE_ENV=\"production\" webpack --config webpack.prod.js",
        "build:check": "npm run typecheck",
        "typecheck": "tsc --noEmit",
        "typecheck:watch": "tsc --noEmit --watch",
        "generate:tesserafin-sdk": "node scripts/generate-tesserafin-sdk.mjs",
        "generate:tokens": "node tesserafin-design/scripts/generate-web-tokens.mjs",
        "verify:openapi-templates": "node scripts/verify-openapi-templates.mjs",
        "verify:tesserafin-sdk-fresh": "node scripts/verify-tesserafin-sdk-fresh.mjs",
        "verify:version-single-source": "node scripts/verify-version-single-source.mjs",
        "verify:no-new-reefin": "node scripts/verify-no-new-reefin.mjs",
        "verify:no-runtime-jellyfin": "node scripts/verify-no-runtime-jellyfin.mjs",
        "verify:runtime-origins": "node scripts/verify-runtime-origins.mjs",
        "verify:console-url-hygiene": "node scripts/verify-console-url-hygiene.mjs",
        "verify:console-url-hygiene:bundle": "node scripts/verify-console-url-hygiene.mjs --dist dist",
        "verify:tokens-fresh": "node scripts/verify-tokens-fresh.mjs",
        "verify:bundle-budget": "node scripts/verify-bundle-budget.mjs",
        "verify:delivery-budget": "node scripts/verify-delivery-budget.mjs --report-json delivery-stats/report.json",
        "report:delivery-budget": "node scripts/verify-delivery-budget.mjs --report-only --report-json delivery-stats/report-preview.json",
        "audit:dependencies": "node scripts/dependency-audit.mjs --scan --work dependency-audit-out --summary dependency-audit-out/summary.md",
        "test:dependency-audit": "node scripts/dependency-audit.test.mjs",
        "test:delivery-budget": "node scripts/delivery-budget.test.mjs",
        "test:epub-xmldom-fallback": "node scripts/epub-xmldom-fallback.test.mjs",
        "test:console-url-hygiene": "node scripts/console-url-hygiene.test.mjs",
        "verify:credential-transport-inventory": "node ci/credential-transport-inventory.mjs",
        "lint": "biome check .",
        "format": "biome format --write .",
        "test": "vitest --watch=false --config vite.config.ts",
        "test:e2e": "playwright test",
        "test:readers": "playwright test --config playwright.reader.config.ts",
        "build:captures": "webpack --config webpack.captures.js",
        "captures": "npm run build:captures && node tests/captures/prepare-tokens.mjs && playwright test --config playwright.captures.config.ts",
        "test:watch": "vitest --config vite.config.ts",
        "stylelint": "stylelint \"src/**/*.{css,scss}\"",
        "validate": "npm run typecheck && npm run lint && npm run stylelint && npm run test && npm run test:epub-xmldom-fallback && npm run verify:console-url-hygiene && npm run test:console-url-hygiene && npm run verify:jellyfin-apiclient-patch && npm run test:jellyfin-apiclient-patch",
        "validate:full": "npm run validate && npm run test:delivery-budget && npm run build:production && npm run verify:credential-transport-inventory && npm run verify:console-url-hygiene:bundle && npm run verify:bundle-budget && npm run verify:delivery-budget && npm run verify:tesserafin-sdk-fresh && npm run verify:tokens-fresh && npm run verify:no-new-reefin && npm run verify:no-runtime-jellyfin && npm run verify:version-single-source",
        "secret-scan:controls": "./ci/tests/secret-scan.test.sh",
        "secret-scan:tree": "./ci/secret-scan.sh --mode tree --repo-name tesserafin-web",
        "secret-scan:history": "./ci/secret-scan.sh --mode history --repo-name tesserafin-web --default-branch main --min-commits 25000 --min-refs 10",
        "test:item-details-browser": "playwright test --config playwright.itemDetails.config.ts",
        "test:delivery-ledger": "playwright test --config playwright.delivery.config.ts",
        "test:content-packs-browser": "node -e \"require('node:fs').rmSync('test-results/runtime-origins.jsonl',{force:true})\" && playwright test --config playwright.contentPacks.config.ts && node scripts/verify-runtime-origins.mjs --expect-specs contentPacks.smoke.spec.ts,contentPacks.manager.spec.ts,contentPacks.nonManager.spec.ts,contentPacks.assignment.spec.ts,contentPacks.isolation.spec.ts,contentPacks.states.spec.ts,contentPacks.keyboard.spec.ts,contentPacks.axe.spec.ts,contentPacks.mobile.spec.ts,contentPacks.tv.spec.ts,support/captureSpecBody.ts",
        "test:m3-browser": "node -e \"require('node:fs').rmSync('test-results/runtime-origins.jsonl',{force:true})\" && playwright test --config playwright.m3.config.ts && node scripts/verify-runtime-origins.mjs --expect-specs m3.onboarding.spec.ts,m3.failures.spec.ts,m3.navigation.spec.ts,m3.keyboard.spec.ts,m3.axe.spec.ts,m3.captures.spec.ts,m3.mobile.spec.ts,m3.geometry.mobile.spec.ts,m3.matrix.spec.ts,m3.matrix.mobile.spec.ts,m3.matrix.tv.spec.ts,m3.tv.spec.ts,m3Captures.mobile.spec.ts,m3Captures.tv.spec.ts",
        "postinstall": "node scripts/patch-jellyfin-apiclient.mjs",
        "verify:jellyfin-apiclient-patch": "node scripts/patch-jellyfin-apiclient.mjs --verify",
        "test:jellyfin-apiclient-patch": "node scripts/jellyfin-apiclient-patch.test.mjs"
    },
    "engines": {
        "node": ">=24.0.0",
        "npm": ">=11.0.0",
        "yarn": "YARN NO LONGER USED - use npm instead."
    }
}
