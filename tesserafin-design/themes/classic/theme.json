{
    "contractVersion": 2,
    "id": "official.classic",
    "version": "0.4.0",
    "name": "Tesserafin Classic",
    "description": "The default Tesserafin experience: the canonical paper-and-ink palette, the four elements as semantic accents, opaque surfaces, no frosted treatment.",
    "author": "Tesserafin Project",
    "license": "GPL-2.0-or-later",
    "compatibility": {
        "web": ">=13.0"
    },
    "modes": ["dark", "light"],
    "presentation": {
        "surface": {
            "variant": "opaque",
            "border": "none",
            "elevation": "level1"
        },
        "mediaCard": {
            "imageAspect": "poster",
            "titlePlacement": "below",
            "hoverEffect": "lift",
            "progressStyle": "bar"
        },
        "navigation": {
            "shell": "sidebar",
            "labels": "always",
            "position": "start"
        },
        "page": {
            "home": {
                "sections": [
                    "libraries",
                    "continueWatching",
                    "nextUp",
                    "latestMedia"
                ],
                "shelfDensity": "comfortable"
            }
        }
    },
    "capabilities": {
        "required": ["tokens.core"],
        "optional": [
            "presentation.surface",
            "presentation.mediaCard",
            "presentation.navigation",
            "presentation.page.home"
        ]
    },
    "renderers": {
        "web": {
            "supports": [
                "tokens.core",
                "tokens.profiles",
                "presentation.surface",
                "presentation.mediaCard",
                "presentation.navigation",
                "presentation.page.home"
            ],
            "source": {
                "kind": "none"
            }
        }
    },
    "lineage": {
        "remixable": true,
        "attribution": "Based on Tesserafin Classic by the Tesserafin Project."
    }
}
