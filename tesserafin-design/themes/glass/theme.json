{
    "contractVersion": 2,
    "id": "official.glass",
    "version": "1.1.0",
    "name": "Tesserafin Glass",
    "description": "A frosted-glass experience: translucent surfaces, blur-backed panels, softened elevation.",
    "author": "Tesserafin Project",
    "license": "GPL-2.0-or-later",
    "compatibility": {
        "web": ">=13.0"
    },
    "modes": ["dark", "light"],
    "presentation": {
        "surface": {
            "variant": "glass",
            "border": "hairline",
            "elevation": "level2"
        },
        "mediaCard": {
            "imageAspect": "poster",
            "titlePlacement": "below",
            "hoverEffect": "lift",
            "progressStyle": "bar"
        },
        "navigation": {
            "shell": "sidebar",
            "labels": "always",
            "position": "start"
        },
        "page": {
            "home": {
                "sections": [
                    "hero",
                    "continueWatching",
                    "nextUp",
                    "latestMedia",
                    "libraries"
                ],
                "shelfDensity": "spacious"
            },
            "library": {
                "layout": "shelf",
                "cardAspect": "backdrop",
                "filters": "drawer"
            },
            "itemDetails": {
                "hero": "poster",
                "sections": [
                    "overview",
                    "cast",
                    "nextUp",
                    "episodes",
                    "moreFrom",
                    "lyrics",
                    "extras",
                    "chapters",
                    "schedule",
                    "related",
                    "mediaInfo"
                ]
            }
        }
    },
    "capabilities": {
        "required": ["tokens.core"],
        "optional": [
            "tokens.profiles",
            "presentation.surface",
            "presentation.mediaCard",
            "presentation.navigation",
            "presentation.page.home",
            "presentation.page.library",
            "presentation.page.itemDetails"
        ]
    },
    "renderers": {
        "web": {
            "supports": [
                "tokens.core",
                "tokens.profiles",
                "presentation.surface",
                "presentation.mediaCard",
                "presentation.navigation",
                "presentation.page.home",
                "presentation.page.library",
                "presentation.page.itemDetails"
            ],
            "source": {
                "kind": "none"
            }
        }
    },
    "lineage": {
        "remixable": true,
        "attribution": "Based on Tesserafin Glass by the Tesserafin Project."
    }
}
