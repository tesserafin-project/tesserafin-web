# npm
dist
# Anchored: this is the top-level build output directory. Unanchored, `web` matches a directory of
# that name at ANY depth, which silently untracked `tesserafin-design/web/` — a source directory that
# builds depend on. That failure is invisible locally (the file is on disk) and only surfaces as a
# broken build from a fresh clone, so keep the leading slash.
/web
node_modules

# test coverage
coverage

# config
config.json

# ide
.idea
.vs

# vim
*.sw?

# direnv
.direnv/

# environment related
.envrc

# playwright
test-results/
playwright-report/

# Aggregate delivery budget evidence: the slim asset graph emitted by the production build
# (scripts/lib/delivery-stats-plugin.cjs) and the JSON report derived from it
# (scripts/verify-delivery-budget.mjs). Both are per-build measurements, regenerated by
# `npm run build:production`; the committed record of the baseline is the table in
# docs/tesserafin/web-delivery-budget.md, not a generated dump.
delivery-stats/

# dependency-audit evidence: the full `npm audit --json` report and its Markdown
# summary (scripts/dependency-audit.mjs). The hosted job uploads these as a
# short-retention artifact; they are never committed.
dependency-audit-out/

# Local environment overrides. Preventive: nothing secret belongs in a browser
# build, and a build-time variable is public the moment it is bundled. There is
# no committed `.env.example` in this repository, and the negation below is
# there so that adding one later stays tracked.
.env
.env.*
!.env.example

# Private key material. There is no tracked .pem/.key/.p12/.pfx in this
# repository (verified with `git ls-files`). No fixture or certificate directory
# is excluded wholesale — hiding a directory to make a scan green would remove
# real files from review.
*.pem
*.key
*.p12
*.pfx
id_rsa
id_ecdsa
id_ed25519

# Server-free capture suite: the harness bundle and the token sets it serves are build
# artifacts. The captures under tests/captures/out/ are evidence and are attached to the PR
# rather than committed, so a design iteration does not put binaries in the history.
tests/captures/dist/
tests/captures/out/
