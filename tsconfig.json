{
    "compilerOptions": {
        "target": "ES2020",
        "lib": ["DOM", "DOM.Iterable", "ES2015"],
        "allowJs": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "noImplicitAny": true,
        "allowSyntheticDefaultImports": true,
        "strict": true,
        "module": "ESNext",
        "moduleResolution": "bundler",
        "resolveJsonModule": true,
        "outDir": "./dist/",
        "checkJs": false,
        "strictNullChecks": true,
        "jsx": "react-jsx",
        "paths": {
            "*": ["./src/*"]
        }
    },
    "include": ["src"],
    "exclude": ["src/lib/reefin-sdk/generated"]
}
